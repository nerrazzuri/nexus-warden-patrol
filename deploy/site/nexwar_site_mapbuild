#!/bin/sh
# 站点主机出图(W75 方案 1):站点程序(nexwar_site.mapbuild)起它,在机器人边走边传上来的关键帧上
# 跑回环、出点云、栅格、先验。参数原样交给 ``nexwar_localizer.tools``(build --from-keyframes …)。
#
# 跑在 ROS 的系统 Python 里(MOLA 的命令行、numpy 在那边);代码用 install-site.sh --with-mapping
# 放进 /opt/nexwar_site/mapping 的那一份 packages/localizer 与 packages/contract(纯 Python)。
set -eu
here=/opt/nexwar_site/mapping
# ROS 的 setup 脚本里有未定义变量,关掉 -u 再 source
set +u
. /opt/ros/humble/setup.sh
set -u
export NEXWAR_SUPERLIO_ROOT="$here/superlio"
export PYTHONPATH="$here/localizer:$here/contract${PYTHONPATH:+:$PYTHONPATH}"
exec /usr/bin/python3 -m nexwar_localizer.tools "$@"
